# Sin ninguna variable, Huella arranca en MODO DEMO (base de datos en memoria,
# WhatsApp y Google simulados). Rellena lo que necesites para producción.

# URL pública (para enlaces en WhatsApp, Google Calendar y el QR)
APP_URL=https://tu-dominio.com

# Firma de sesiones y del parámetro OAuth. Obligatorio en producción. `openssl rand -base64 32`
SESSION_SECRET=

# --- Supabase (Postgres) — usar la service-role key, solo en el servidor
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Tarea programada de recordatorios (Vercel Cron envía "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=

# --- WhatsApp Cloud API (Meta)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v23.0
WA_TEMPLATE_LANG=es_MX
WA_TEMPLATE_BOOKED=cita_agendada
WA_TEMPLATE_REMINDER=recordatorio_cita
WA_TEMPLATE_FOLLOW_UP=seguimiento_revision

# --- Google Calendar (OAuth 2.0, tipo "Aplicación web")
# URI de redirección autorizada: {APP_URL}/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Moneda para mostrar precios
NEXT_PUBLIC_CURRENCY=MXN
